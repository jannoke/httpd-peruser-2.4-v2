--- a/modules/generators/mod_handler_guard.c	1970-01-01 00:00:00.000000000 +0000
+++ b/modules/generators/mod_handler_guard.c	1970-01-01 00:00:00.000000000 +0000
@@ -0,0 +1,158 @@
+/* Licensed under the Apache License, Version 2.0 (the "License"); you may not
+ * use this file except in compliance with the License. You may obtain a copy
+ * of the License at http://www.apache.org/licenses/LICENSE-2.0
+ */
+
+/*
+ * mod_handler_guard: keep the server's admin handlers (server-status,
+ * server-info, ...) to the virtual hosts that are allowed them.
+ *
+ * Why: mod_status and mod_info don't check where their handler was set. With
+ * AllowOverride FileInfo, a tenant's .htaccess can say "SetHandler
+ * server-status" (or AddHandler, AddType application/x-httpd-status,
+ * RewriteRule [H=...]) and read every vhost's live requests, or the whole
+ * configuration. Nothing in the configuration can stop that: <If> and
+ * Require run before core's fixups apply the .htaccess handler. The handler
+ * phase is the first place that sees the final handler, so this module checks
+ * it there, before any other handler runs.
+ *
+ *   HandlerGuard handler [handler] ...
+ *       Main server config only. The handlers to guard. Without it:
+ *       server-status, application/x-httpd-status, server-info,
+ *       balancer-manager.
+ *   HandlerGuardAllow On|Off
+ *       <VirtualHost> only, so it can't be inherited by every vhost and
+ *       can't come from .htaccess. That vhost may use the guarded handlers.
+ *
+ * Everywhere else a guarded handler is answered 403, with a warning in the
+ * error log naming the vhost and the file.
+ */
+
+#include "httpd.h"
+#include "http_config.h"
+#include "http_core.h"
+#include "http_log.h"
+#include "http_request.h"
+#include "apr_strings.h"
+
+module AP_MODULE_DECLARE_DATA handler_guard_module;
+
+static const char *const default_handlers[] = {
+    "server-status",
+    "application/x-httpd-status",
+    "server-info",
+    "balancer-manager",
+    NULL
+};
+
+typedef struct {
+    apr_array_header_t *handlers;   /* main server's list; NULL = defaults */
+    int allow;                      /* 1 = this vhost may use them */
+} guard_conf;
+
+static void *create_guard_conf(apr_pool_t *p, server_rec *s)
+{
+    guard_conf *conf = apr_pcalloc(p, sizeof(*conf));
+    return conf;
+}
+
+static void *merge_guard_conf(apr_pool_t *p, void *basev, void *addv)
+{
+    guard_conf *base = basev, *add = addv;
+    guard_conf *conf = apr_pcalloc(p, sizeof(*conf));
+
+    /* The list is the main server's; HandlerGuardAllow is never inherited. */
+    conf->handlers = base->handlers;
+    conf->allow = add->allow;
+    return conf;
+}
+
+static const char *set_handlers(cmd_parms *cmd, void *dummy, const char *arg)
+{
+    guard_conf *conf = ap_get_module_config(cmd->server->module_config,
+                                            &handler_guard_module);
+
+    if (cmd->server->is_virtual) {
+        return "HandlerGuard belongs in the main server configuration";
+    }
+    if (conf->handlers == NULL) {
+        conf->handlers = apr_array_make(cmd->pool, 4, sizeof(const char *));
+    }
+    APR_ARRAY_PUSH(conf->handlers, const char *) = apr_pstrdup(cmd->pool, arg);
+    return NULL;
+}
+
+static const char *set_allow(cmd_parms *cmd, void *dummy, int flag)
+{
+    guard_conf *conf = ap_get_module_config(cmd->server->module_config,
+                                            &handler_guard_module);
+
+    if (!cmd->server->is_virtual) {
+        return "HandlerGuardAllow is only allowed inside <VirtualHost>";
+    }
+    conf->allow = flag;
+    return NULL;
+}
+
+static int is_guarded(const guard_conf *conf, const char *handler)
+{
+    int i;
+
+    if (conf->handlers == NULL) {
+        for (i = 0; default_handlers[i] != NULL; i++) {
+            if (!strcasecmp(handler, default_handlers[i])) {
+                return 1;
+            }
+        }
+        return 0;
+    }
+    for (i = 0; i < conf->handlers->nelts; i++) {
+        if (!strcasecmp(handler, APR_ARRAY_IDX(conf->handlers, i, const char *))) {
+            return 1;
+        }
+    }
+    return 0;
+}
+
+static int guard_handler(request_rec *r)
+{
+    const guard_conf *conf;
+
+    if (r->handler == NULL) {
+        return DECLINED;
+    }
+    conf = ap_get_module_config(r->server->module_config, &handler_guard_module);
+    if (conf->allow || !is_guarded(conf, r->handler)) {
+        return DECLINED;
+    }
+
+    ap_log_rerror(APLOG_MARK, APLOG_WARNING, 0, r,
+                  "handler-guard: refused handler \"%s\" for %s on vhost %s; "
+                  "only a <VirtualHost> with HandlerGuardAllow On may use it",
+                  r->handler, r->filename ? r->filename : r->uri,
+                  r->server->server_hostname ? r->server->server_hostname : "-");
+    return HTTP_FORBIDDEN;
+}
+
+static void register_hooks(apr_pool_t *p)
+{
+    ap_hook_handler(guard_handler, NULL, NULL, APR_HOOK_REALLY_FIRST);
+}
+
+static const command_rec guard_cmds[] = {
+    AP_INIT_ITERATE("HandlerGuard", set_handlers, NULL, RSRC_CONF,
+                    "Handlers only a VirtualHost with HandlerGuardAllow On may use"),
+    AP_INIT_FLAG("HandlerGuardAllow", set_allow, NULL, RSRC_CONF,
+                 "On: this VirtualHost may use the guarded handlers"),
+    {NULL}
+};
+
+AP_DECLARE_MODULE(handler_guard) = {
+    STANDARD20_MODULE_STUFF,
+    NULL,                       /* dir config creator */
+    NULL,                       /* dir merger */
+    create_guard_conf,          /* server config */
+    merge_guard_conf,           /* merge server config */
+    guard_cmds,                 /* command table */
+    register_hooks
+};
